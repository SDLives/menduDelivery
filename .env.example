# Postgres (local via Supabase CLI em dev; string de conexão do projeto Supabase em produção)
# Conecta como `mendu_app` (criado em supabase/migrations/0000_app_role.sql), não como o
# superuser `postgres` — `postgres` tem BYPASSRLS por padrão no Supabase local/cloud, o que
# tornaria as políticas de RLS (Task 5) inertes. Senha abaixo é só para dev local; produção usa
# credenciais gerenciadas pelo próprio Supabase.
DATABASE_URL=postgresql://mendu_app:mendu_app_dev_password@localhost:54322/postgres
DATABASE_URL_TEST=postgresql://mendu_app:mendu_app_dev_password@localhost:54322/postgres

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=changeme
SUPABASE_SERVICE_ROLE_KEY=changeme

# Bunny.net (Storage + CDN) — necessário a partir da Task 11
BUNNY_STORAGE_ZONE=changeme
BUNNY_STORAGE_API_KEY=changeme
BUNNY_CDN_BASE_URL=https://changeme.b-cdn.net
